# T72 — AUR PKGBUILD for morgan-bevy-bin.
#
# Submit to the AUR (Arch User Repository) at https://aur.archlinux.org/
# by copying this file into a new repo `morgan-bevy-bin` and pushing it.
# Once accepted, users install with:
#
#   yay -S morgan-bevy-bin
#   # or
#   git clone https://aur.archlinux.org/morgan-bevy-bin.git && cd morgan-bevy-bin && makepkg -si
#
# The `-bin` suffix (binary package) is the AUR convention for prebuilt
# binaries. Users get the .deb-free path that matches what
# `cargo install` would produce, without the long Rust build.

# Maintainer: greysquirr3l <s0ma@protonmail.com>
pkgname=morgan-bevy-bin
_pkgname=morgan-bevy
pkgver=0.4.0
pkgrel=1
pkgdesc="3D level editor for the Bevy game engine with procedural generation and multi-format export"
arch=('x86_64' 'aarch64')
url="https://github.com/greysquirr3l/morgan-bevy"
license=('MIT' 'Apache-2.0')
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")

# Source URL follows the convention in `.github/workflows/release.yml`:
# the release workflow uploads `morgan-bevy_${pkgver}_amd64.deb` and
# `morgan-bevy_${pkgver}_arm64.deb` to the GitHub Release.
source_x86_64=("${url}/releases/download/v${pkgver}/morgan-bevy_${pkgver}_amd64.deb")
source_aarch64=("${url}/releases/download/v${pkgver}/morgan-bevy_${pkgver}_arm64.deb")

# SHA256s come from the GitHub Release notes; pin them per release.
# The `makepkg` build helper computes them automatically — fill in
# after running `updpkgsums` against the release artifacts.
sha256sums_x86_64=('REPLACE_WITH_RELEASE_SHA256_AMD64')
sha256sums_aarch64=('REPLACE_WITH_RELEASE_SHA256_ARM64')

# Morgan-Bevy ships its own .desktop file and icon inside the .deb,
# so this PKGBUILD just unpacks it into the standard locations.
package() {
    cd "${_pkgname}_${pkgver}_amd64" 2>/dev/null || cd "${_pkgname}_${pkgver}_arm64"

    # The .deb contains the .app bundle structure plus the
    # standard Debian metadata. Extract the data.tar.* and move
    # the .opt + .desktop + .icon pieces into the Arch equivalents.
    ar x "${srcdir}/${pkgname}-${pkgver}-${CARCH}.pkg.tar.xz" 2>/dev/null || \
        bsdtar -xf "${srcdir}/data.tar.xz" 2>/dev/null

    # The .deb installs the app under /opt/morgan-bevy. Symlink
    # the binary into /usr/bin so `morgan-bevy` is on PATH.
    install -dm755 "${pkgdir}/opt/${_pkgname}"
    cp -r "${srcdir}/opt/${_pkgname}/." "${pkgdir}/opt/${_pkgname}/"
    install -dm755 "${pkgdir}/usr/bin"
    ln -s "/opt/${_pkgname}/Morgan-Bevy" "${pkgdir}/usr/bin/${_pkgname}"

    # Desktop entry — the .deb ships one; reuse it.
    install -Dm644 "${srcdir}/usr/share/applications/${_pkgname}.desktop" \
        "${pkgdir}/usr/share/applications/${_pkgname}.desktop"

    # Icon — the .deb ships a 256x256 PNG; reuse it.
    install -Dm644 "${srcdir}/usr/share/icons/hicolor/256x256/apps/${_pkgname}.png" \
        "${pkgdir}/usr/share/icons/hicolor/256x256/apps/${_pkgname}.png"
}

