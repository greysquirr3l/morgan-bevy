{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morgan-Bevy",
  "version": "0.4.0",
  "identifier": "com.morgan-bevy.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Morgan-Bevy",
        "width": 1200,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "longDescription": "A hybrid 3D level editor for Bevy game development combining procedural generation with professional manual editing capabilities.",
    "shortDescription": "3D Level Editor for Bevy",
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["morgan"],
        "name": "Morgan-Bevy Project",
        "description": "A Morgan-Bevy 3D level project file",
        "mimeType": "application/x-morgan-project",
        "role": "Editor",
        "rank": "Owner"
      },
      {
        "ext": ["morgan-project"],
        "name": "Morgan-Bevy Project (legacy)",
        "description": "A Morgan-Bevy 3D level project file (legacy extension)",
        "mimeType": "application/x-morgan-project",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://github.com/greysquirr3l/morgan-bevy/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_YOUR_TAURI_UPDATER_PUBLIC_KEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
